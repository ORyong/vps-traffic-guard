# VPS traffic monitor configuration.
# Copy to /etc/vps-traffic-monitor.env and set chmod 600.

# Choose one push channel: telegram or bark.
PUSH_CHANNEL=telegram

# Display name shown in notifications. Leave empty to use system hostname.
VPS_NAME=

# Telegram settings. Required when PUSH_CHANNEL=telegram.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Bark settings. Required when PUSH_CHANNEL=bark.
# Examples:
#   BARK_URL=https://api.day.app/YOUR_KEY
#   BARK_URL=https://your-bark.example.com/YOUR_KEY
BARK_URL=

# Monthly quota. RX + TX are counted together.
TRAFFIC_LIMIT_GB=1024

# Send an alert once the monthly quota reaches this percentage.
ALERT_PERCENT=80

# Use auto unless you need to pin a specific interface such as ens3 or eth0.
IFACE=auto

# Runtime state directory. Use a writable absolute path.
STATE_DIR=/var/lib/vps-traffic-monitor

# Used for daily/weekly/monthly period boundaries and report timestamps.
TIMEZONE=Asia/Shanghai
